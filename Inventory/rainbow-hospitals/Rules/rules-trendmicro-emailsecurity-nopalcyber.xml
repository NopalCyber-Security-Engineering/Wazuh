<!-- /var/ossec/etc/rules/trendmicro_security.xml -->
<group name="trendmicro_ems_security,">

    <!-- Base Rule -->
  <rule id="115100" level="0" noalert="1">
    <decoded_as>json</decoded_as>
    <field name="integration">trendmicro-ems</field>
    <description>Trend Micro Email Security: Log received</description>
  </rule>
  
    <!-- Base rule - Email Delivered (115101) -->
  <rule id="115101" level="3">
    <if_sid>115100</if_sid>
    <field name="data.trendmicro_ems.action">Delivered</field>
    <description>Email Delivered</description>
    <options>no_full_log</options>
  </rule>

  <!-- Malware Detonation Attempt (115101) -->
  <rule id="115102" level="3">
    <if_sid>115100</if_sid>
    <field name="trendmicro_ems.action">Scanning in sandbox</field>
    <description>SECURITY ALERT: Suspicious email quarantined for sandbox analysis</description>
    <group>malware_analysis</group>
  </rule>

  <!-- Executable Attachment Detection (115102) -->
  <rule id="115103" level="11">
    <if_sid>115100</if_sid>
    <field name="trendmicro_ems.attachments.fileName" type="pcre2">\.(exe|js|vbs|wsf|scr|jar|bat|cmd|dll|lnk|hta|ppam)$</field>
    <description>MALWARE ALERT: Email contains executable attachment</description>
    <group>malware_detection</group>
  </rule>

  <!-- Phishing Attempt Detection (115103) WIP -->
  <rule id="115104" level="10">
    <if_sid>115100</if_sid>
    <field name="trendmicro_ems.embeddedUrls" type="pcre2">>=5</field>
    <description>PHISHING ATTEMPT: Email contains suspicious URLs</description>
    <group>phishing_detection</group>
  </rule>

  <!-- Credential Harvesting (115104) --> <!-- Improvement - Exclude internal email communication -->
  <rule id="115105" level="3">
    <if_sid>115100</if_sid>
    <field name="trendmicro_ems.subject" type="pcre2">(?i)password|login|credentials|account\s+verification|security\s+alert|urgent</field>
    <description>CREDENTIAL HARVESTING: Suspicious subject line detected</description>
    <group>credential_theft</group>
  </rule>

  <!-- Suspicious Sender Domains (115105) --> <!-- Improvement - Check sender is rainbow hospital email or not -->
  <rule id="115106" level="3">
    <if_sid>115100</if_sid>
    <field name="trendmicro_ems.sender" type="pcre2">@(gmail\.com|yahoo\.com|hotmail\.com|outlook\.com|protonmail\.com|aol\.com|icloud\.com)$</field>
    <field name="trendmicro_ems.direction">in</field>
    <description>SUSPICIOUS SENDER: External personal email account used for business communication</description>
    <group>suspicious_sender</group>
  </rule>

  <!-- Large Attachment Alert > 10MB (115106)  WIP -->
  
  <rule id="115107" level="6">
    <if_sid>115100</if_sid>
    <field name="trendmicro_ems.size">>=10485760</field>
    <description>Trend Micro: Large email with multiple attachments</description>
    <group>data_exfiltration</group>
  </rule>
  

  <!-- Multiple Recipients Alert (115107) -->
  <rule id="115108" level="5" frequency="10" timeframe="300">
    <if_matched_sid>115101</if_matched_sid> <!-- Email Delivered -->
    <same_field>trendmicro_ems.subject</same_field>
    <same_field>trendmicro_ems.sender</same_field>
    <different_field>trendmicro_ems.recipient</different_field>
    <description>Trend Micro: Mass email to multiple recipients</description>
    <group>bulk_email</group>
  </rule>

  <!-- Deferred Messages (115108) --> <!-- Improve -->
  <rule id="115109" level="3">
    <if_sid>115100</if_sid>
    <field name="trendmicro_ems.action">Deferred</field>
    <description>DELIVERY ISSUE: Email delivery was delayed or postponed by the server</description>
    <options>no_full_log</options>
    <group>delivery_issues</group>
  </rule>
  
<!-- Multiple malware detonation attempts detected -->
<rule id="115110" level="3" frequency="5" timeframe="300">
    <if_matched_sid>115102</if_matched_sid>
    <description>SECURITY ALERT: Multiple suspicious emails submitted for sandbox analysis (5 events within 5 minutes).</description>
    <group>trendmicro,email_security,malware_analysis,correlation</group>
</rule>

<!-- Single sender triggering repeated sandbox analysis -->
<rule id="115111" level="3" frequency="5" timeframe="300">
    <if_matched_sid>115102</if_matched_sid>
    <same_field>trendmicro_ems.sender</same_field>
    <description>SECURITY ALERT: Sender triggered repeated email sandbox analysis (3 events within 5 minutes).</description>
    <group>trendmicro,email_security,malware_analysis,correlation</group>
</rule>

<!-- Single recipient targeted by repeated sandboxed emails -->
<rule id="115112" level="3" frequency="5" timeframe="300">
    <if_matched_sid>115102</if_matched_sid>
    <same_field>trendmicro_ems.recipient</same_field>
    <description>SECURITY ALERT: Recipient received repeated emails submitted for sandbox analysis (3 events within 5 minutes).</description>
    <group>trendmicro,email_security,malware_analysis,correlation</group>
</rule>

  
</group>
