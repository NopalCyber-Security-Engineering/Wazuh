<!-- Modify it at your will. -->

<!-- Rules for SentinelOne via API -->

<!-- SentinelOne logs grouped -->
<group name="sentinelone_API">
  <rule id="100600" level="3"> <!-- Reduce rule level below 5 to reduce duplicate alerts to Jira -->
    <decoded_as>json</decoded_as>
    <location>/var/log/sentinelone.json</location>
    <description>Logs from SentinelOne.</description>
  </rule>
  
  <!-- Rules to detect active threat -->
  <rule id="100601" level="3">  <!-- Reduce rule level below 5 to reduce duplicate alerts to Jira -->
    <if_sid>100600</if_sid>
    <field name="agentDetectionInfo.agentMitigationMode">detect</field>
    <description>SentinelOne: New active threat $(threatInfo.threatName) detected on endpoint.</description>
  </rule>
  
  <!-- Rules to detect successfully mitigated threat -->
  <rule id="100602" level="3">  <!-- Reduce rule level below 5 to reduce duplicate alerts to Jira -->
    <if_sid>100600</if_sid>
    <field name="threatInfo.mitigationStatus">mitigated</field>
    <description>SentinelOne: Threat $(threatInfo.threatName) successfully mitigated on endpoint</description>
  </rule>
  
    <!-- Rules to detect multiple active threats -->
    <rule id="100603" level="3" ignore="120">   <!-- Reduce rule level below 5 to reduce duplicate alerts to Jira -->
      <if_sid>100600</if_sid>
      <field name="agentRealtimeInfo.activeThreats">[4-9]\d*|\d{2,}</field>
      <description>SentinelOne: Multiple active threats detected on endpoint</description>
    </rule>
  
  <!-- Rules to detect reboot required -->
  <rule id="100604" level="3">  <!-- Reduce rule level below 5 to reduce duplicate alerts to Jira -->
    <if_sid>100600</if_sid>
    <field name="agentRealtimeInfo.rebootRequired">true</field>
    <description>SentinelOne: System reboot required to complete actions</description>

  </rule>
  
</group>